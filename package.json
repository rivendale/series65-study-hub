{
  "name": "series65-study-hub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free, open-source, mobile-first Series 65 study app with a CFP intro track",
  "license": "MIT",
  "homepage": "https://rivendale.github.io/series65-study-hub/",
  "author": "Nicholas Rygiel",
  "repository": {
    "type": "git",
    "url": "https://github.com/rivendale/series65-study-hub.git"
  },
  "bugs": {
    "url": "https://github.com/rivendale/series65-study-hub/issues"
  },
  "keywords": [
    "series-65",
    "nasaa",
    "finra",
    "investment-adviser",
    "cfp",
    "exam-prep",
    "study-guide",
    "pwa",
    "react",
    "open-source"
  ],
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "review:md": "node scripts/generate-review.mjs",
    "core:check": "node scripts/check-core.mjs",
    "core:regen": "node scripts/check-core.mjs --regen"
  },
  "dependencies": {
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^7.3.2",
    "vite-plugin-pwa": "^1.2.0",
    "workbox-window": "^7.3.0"
  }
}
