rules_version = '2';
// Per-user isolation is the entire security model: a signed-in family member
// can read and write exactly ONE document — their own record for this app —
// and nothing else in the database. There is no cross-user read, no listing,
// and no unauthenticated access. Server-side enforcement; the client is not
// trusted.
//
// Deploy: Firebase console → Firestore → Rules → paste → Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /apps/{appId}/users/{uid} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        // A progress record is kilobytes; a megabyte write is not a record.
        && (request.resource == null
            || request.resource.data.record is string
                && request.resource.data.record.size() < 262144);
    }
  }
}
